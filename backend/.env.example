# Copy to backend/.env and fill in. Never commit the real .env.

# Supabase project (Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Optional: require `X-API-Key: <value>` on all write endpoints
API_KEY=

# Comma-separated allowed browser origins for the dashboard
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Set to false in production to disable fault-injection endpoints
ENABLE_DEMO_ENDPOINTS=true

# Optional overrides
# ML_MODEL_DIR=../ml/models
# MAX_BATCH_SIZE=500
# MAX_DEMO_GENERATE_HOURS=72
# LOG_LEVEL=INFO
